# Pantau configuration.
# Copy this file to `.env` and fill in your values. Git ignores `.env`.
# Every key is optional. If a key is blank, the app skips its collector and the
# footer health dot for that collector goes dark. With no keys at all the app
# still runs the YouTube live search and Google News collectors.

# Key for the AI situation brief. Get one at https://openrouter.ai/settings/keys
# Without this key the brief panel stays empty. All other panels work.
OPENROUTER_API_KEY=
# Any OpenRouter model id. A cheap reasoning-capable "flash" model works well.
SUMMARY_MODEL=z-ai/glm-5.3-flash

# EulerStream signing key for TikTok LIVE detection. Get one at https://www.eulerstream.com
# Without this key the app skips the TikTok watchlist collector.
SIGN_API_KEY=

# Residential SOCKS5 proxy in the format socks5://host:port
# TikTok and Yahoo Finance block datacenter IP addresses, so the TikTok and
# markets collectors send their requests through this proxy. Use any residential
# proxy that you control, for example a Tailscale exit node on a home connection
# or a commercial residential proxy. Leave this value blank to disable the
# TikTok and markets collectors.
PROXY=

# Public URL. The app sends this value to OpenRouter as the referer header.
# The value has no other effect.
SITE_URL=https://pantau.example

# Your domain. The app uses this value only if you enable the Traefik labels
# in compose.yaml
DOMAIN=pantau.example.com
