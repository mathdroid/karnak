# ── Pantau configuration ──────────────────────────────────────────────
# Copy this file to `.env` and fill in your own values. `.env` is gitignored.
# Every key is OPTIONAL — leave one blank and its collector simply stays quiet
# (the footer health dot for it goes dark). The app runs with none of them,
# serving YouTube live search + Google News, which need no keys at all.

# AI Situation Brief — https://openrouter.ai/settings/keys
# Without it, the brief panel stays empty; everything else works.
OPENROUTER_API_KEY=
# Any OpenRouter model id. A cheap reasoning-capable "flash" model works well.
SUMMARY_MODEL=z-ai/glm-5.3-flash

# TikTok LIVE detection — EulerStream signing key, https://www.eulerstream.com
# Without it, the TikTok watchlist collector is skipped.
SIGN_API_KEY=

# Residential SOCKS5 proxy. TikTok and Yahoo (markets) block datacenter IPs, so
# those two collectors route through this. Point it at any residential proxy you
# control (e.g. a Tailscale exit node on a home line, a commercial proxy, etc).
# Leave blank to disable TikTok + markets. Format: socks5://host:port
PROXY=

# Public URL, sent to OpenRouter as the referer header. Cosmetic.
SITE_URL=https://pantau.example

# Your domain — only used if you enable the Traefik labels in compose.yaml.
DOMAIN=pantau.example.com
